msgstr "स्थिति"

#: pro/licensorpro-client/licensorpro-client.php:1788
msgid "Renew"
msgstr "रिन्यू करें"

#: pro/licensorpro-client/licensorpro-client.php:1792
msgid "Offline mode"
msgstr "ऑफ़लाइन मोड"

#: pro/licensorpro-client/licensorpro-client.php:1794
#, php-format
msgid "cached license valid until %s"
msgstr "कैश किया गया लाइसेंस %s तक मान्य"

#: pro/licensorpro-client/licensorpro-client.php:1798
msgid "Update channel"
msgstr "अपडेट चैनल"

#: pro/licensorpro-client/licensorpro-client.php:1799
msgid "Site limit"
msgstr "साइट सीमा"

#: pro/licensorpro-client/licensorpro-client.php:1800
msgid "Expires"
msgstr "समाप्त होता है"

#: pro/licensorpro-client/licensorpro-client.php:1800
msgid "Never"
msgstr "कभी नहीं"

#: pro/licensorpro-client/licensorpro-client.php:1805
msgid "Deactivate this site"
msgstr "इस साइट को निष्क्रिय करें"

#: pro/licensorpro-client/licensorpro-client.php:1812
msgid "This is the free version, running on your Pro license."
msgstr "यह Free वर्शन है, जो आपके Pro लाइसेंस पर चल रहा है।"

#: pro/licensorpro-client/licensorpro-client.php:1829
msgid "Have a Pro license key? Enter it here to switch on the Pro tools. It replaces the free license on this site."
msgstr "क्या आपके पास Pro लाइसेंस Key है? Pro टूल चालू करने के लिए उसे यहाँ डालें। यह इस साइट के Free लाइसेंस की जगह ले लेगी।"

#: pro/licensorpro-client/licensorpro-client.php:1830
msgid "Enter your license key to activate this site."
msgstr "इस साइट को सक्रिय करने के लिए अपनी लाइसेंस Key डालें।"

#: pro/licensorpro-client/licensorpro-client.php:1837
msgid "Activate"
msgstr "सक्रिय करें"

#: pro/licensorpro-client/licensorpro-client.php:1840
msgid "Your key is in your purchase email and in your account."
msgstr "आपकी Key आपके खरीद वाले ईमेल में और आपके अकाउंट में है।"

#: pro/licensorpro-client/licensorpro-client.php:1848
msgid "Need a hand?"
msgstr "मदद चाहिए?"

#: pro/licensorpro-client/licensorpro-client.php:1849
msgid "Contact support"
msgstr "सहायता से संपर्क करें"

#: pro/licensorpro-client/licensorpro-client.php:2054
msgid "Only someone who may install plugins on this site can install Pro."
msgstr "Pro सिर्फ़ वही इंस्टॉल कर सकता है जिसे इस साइट पर प्लगइन इंस्टॉल करने की अनुमति है।"

#: pro/licensorpro-client/licensorpro-client.php:2067
msgid "That is a free license key, so it keeps this free version updated. Pro needs the key from your purchase email."
msgstr "यह Free लाइसेंस Key है, इसलिए यह इस Free वर्शन को अपडेट रखती है। Pro के लिए आपके खरीद वाले ईमेल की Key चाहिए।"

#. translators: %s: URL of the customer account
#: pro/licensorpro-client/licensorpro-client.php:2072
#, php-format
msgid "Your key is active. Download the Pro zip from your account (%s) and upload it over this plugin instead."
msgstr "आपकी Key सक्रिय है। इसके बजाय अपने अकाउंट (%s) से Pro zip डाउनलोड करें और इसे इस प्लगइन के ऊपर अपलोड करें।"

#: pro/licensorpro-client/licensorpro-client.php:2076
msgid "This site does not allow installing plugins from the dashboard."
msgstr "यह साइट डैशबोर्ड से प्लगइन इंस्टॉल करने की अनुमति नहीं देती।"

#: pro/licensorpro-client/licensorpro-client.php:2080
msgid "The Pro download could not be fetched for this key."
msgstr "इस Key के लिए Pro डाउनलोड नहीं मिल सका।"

#: pro/licensorpro-client/licensorpro-client.php:2088
msgid "This site asks for FTP details to install plugins."
msgstr "प्लगइन इंस्टॉल करने के लिए यह साइट FTP विवरण माँगती है।"

#: pro/licensorpro-client/licensorpro-client.php:2123
msgid "Installing Pro did not finish."
msgstr "Pro इंस्टॉल करना पूरा नहीं हुआ।"

#. translators: %s: plugin name
#: pro/licensorpro-client/licensorpro-client.php:2128
#, php-format
msgid "%s Pro is installed and your license is active. Reloading…"
msgstr "%s Pro इंस्टॉल है और आपका लाइसेंस सक्रिय है। फिर से लोड हो रहा है…"

#: pro/licensorpro-client/licensorpro-client.php:2138
msgid "License activated."
msgstr "लाइसेंस सक्रिय हो गया।"

#: pro/licensorpro-client/licensorpro-client.php:2150
msgid "Site deactivated."
msgstr "साइट निष्क्रिय हो गई।"

#: pro/licensorpro-client/licensorpro-client.php:2161
msgid "License is valid. Update info refreshed."
msgstr "लाइसेंस मान्य है। अपडेट जानकारी ताज़ा की गई।"

#: pro/licensorpro-client/licensorpro-client.php:2168
msgid "Permission denied."
msgstr "अनुमति नहीं है।"

