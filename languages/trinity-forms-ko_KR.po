#: admin/class-form-editor.php:331
msgid "To the right"
msgstr "오른쪽"

#: admin/class-form-editor.php:332
msgid "Hidden (use placeholders)"
msgstr "숨김(플레이스홀더 사용)"

#: admin/class-form-editor.php:334
msgid "Hidden keeps the label for screen readers — it is only removed visually."
msgstr "숨김을 선택해도 화면 낭독기용 레이블은 유지되며, 화면에서만 보이지 않습니다."

#: admin/class-form-editor.php:337 blocks/field-shared.js:107
#: builder/src/field-panel.jsx:21
msgid "Help text"
msgstr "도움말 텍스트"

#: admin/class-form-editor.php:341 admin/class-form-editor.php:373
#: blocks/field-shared.js:153 builder/src/field-panel.jsx:305
