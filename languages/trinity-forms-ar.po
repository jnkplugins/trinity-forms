msgstr "الاحتفاظ بالإدخالات"

#: admin/views/settings.php:185
msgid "Keep entries for (days)"
msgstr "الاحتفاظ بالإدخالات لمدة (بالأيام)"

#: admin/views/settings.php:188
msgid "0 keeps entries forever. A form's own setting overrides this."
msgstr "0 يحتفظ بالإدخالات إلى الأبد. إعداد النموذج الخاص يتجاوز هذا."

