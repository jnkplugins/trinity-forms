#: pro/licensorpro-client/licensorpro-client.php:761
msgid "Manage license"
msgstr "إدارة الترخيص"

#: pro/licensorpro-client/licensorpro-client.php:764
msgid "Renew license"
msgstr "تجديد الترخيص"

#: pro/licensorpro-client/licensorpro-client.php:765
msgid "Activate license"
msgstr "تفعيل الترخيص"

#. translators: %s: plugin name
#: pro/licensorpro-client/licensorpro-client.php:802
#, php-format
msgid "<strong>%s Pro is on.</strong> Thank you! Every Pro tool is switched on for this site, and updates come to your dashboard."
msgstr "<strong>%s Pro مُفعّل.</strong> شكرًا لك! كل أدوات Pro تعمل على هذا الموقع، والتحديثات تصل إلى لوحة التحكم."

#. translators: %s: plugin name
#: pro/licensorpro-client/licensorpro-client.php:851
#, php-format
msgid "<strong>%s Pro is installed, but no Pro license is active on this site.</strong> Enter your license key to switch on the Pro tools."
msgstr "<strong>%s Pro مثبّت، لكن لا يوجد ترخيص Pro نشط على هذا الموقع.</strong> أدخل مفتاح الترخيص لتشغيل أدوات Pro."

#: pro/licensorpro-client/licensorpro-client.php:857 builder/src/app.jsx:904
msgid "Enter license key"
msgstr "أدخل مفتاح الترخيص"

#: pro/licensorpro-client/licensorpro-client.php:860
msgid "Find your key in your account"
msgstr "تجد المفتاح في حسابك"

#: pro/licensorpro-client/licensorpro-client.php:886
msgid "Renew your license"
msgstr "جدّد ترخيصك"

#. translators: 1: plugin name, 2: expiry date, 3: lock date, 4: days left
#: pro/licensorpro-client/licensorpro-client.php:892
#, php-format
msgid "<strong>Your %1$s Pro license expired on %2$s.</strong> Pro keeps working as normal until %3$s (%4$d days left). Updates, including security fixes, and email support have stopped. After %3$s, everything you already set up keeps working and your visitors won't notice a thing, but the Pro tools in your dashboard will lock."
msgstr "<strong>انتهى ترخيص %1$s Pro في %2$s.</strong> يستمر Pro بالعمل كالمعتاد حتى %3$s (بقي %4$d يومًا). توقفت التحديثات، ومنها إصلاحات الأمان، وتوقف الدعم عبر البريد الإلكتروني. بعد %3$s يبقى كل ما أعددته يعمل ولن يلاحظ زوارك أي شيء، لكن أدوات Pro في لوحة التحكم ستُقفل."

#. translators: 1: plugin name, 2: expiry date
#: pro/licensorpro-client/licensorpro-client.php:902
#, php-format
msgid "<strong>%1$s Pro tools are locked because your license expired on %2$s.</strong> Your site, and everything visitors see, still works. Renew to unlock the Pro tools and get updates, including security fixes, again."
msgstr "<strong>أدوات %1$s Pro مقفلة لأن ترخيصك انتهى في %2$s.</strong> موقعك وكل ما يراه الزوار ما زال يعمل. جدّد الترخيص لفتح أدوات Pro والحصول على التحديثات مجددًا، ومنها إصلاحات الأمان."

#. translators: %s: plugin name
#: pro/licensorpro-client/licensorpro-client.php:910
#, php-format
msgid "<strong>This site is no longer activated on your %s Pro license.</strong> The Pro tools in your dashboard are locked until you activate it again. Everything visitors see keeps working."
msgstr "<strong>هذا الموقع لم يعد مُفعّلًا على ترخيص %s Pro.</strong> أدوات Pro في لوحة التحكم مقفلة حتى تفعّله مجددًا. كل ما يراه الزوار يستمر بالعمل."

#. translators: %s: plugin name
#: pro/licensorpro-client/licensorpro-client.php:917
#, php-format
msgid "<strong>Your %s Pro license is no longer active.</strong> It was refunded or cancelled, so the Pro tools in your dashboard are locked and updates have stopped. Everything visitors see keeps working."
msgstr "<strong>ترخيص %s Pro لم يعد نشطًا.</strong> تم استرداد المبلغ أو إلغاء الاشتراك، لذا أُقفلت أدوات Pro في لوحة التحكم وتوقفت التحديثات. كل ما يراه الزوار يستمر بالعمل."

#. translators: %s: plugin name
#: pro/licensorpro-client/licensorpro-client.php:926
#, php-format
msgid "Your %s Pro license is no longer active on this site."
msgstr "لم يعد ترخيص %s Pro الخاص بك نشطًا على هذا الموقع."

#: pro/licensorpro-client/licensorpro-client.php:1072
msgid "Please enter a license key."
msgstr "الرجاء إدخال مفتاح ترخيص."

#: pro/licensorpro-client/licensorpro-client.php:1087
#: pro/licensorpro-client/licensorpro-client.php:1147
msgid "License response failed signature verification."
msgstr "فشل التحقق من توقيع رد الترخيص."

#: pro/licensorpro-client/licensorpro-client.php:1129
msgid "No license key set."
msgstr "لم يتم تعيين مفتاح ترخيص."

#: pro/licensorpro-client/licensorpro-client.php:1284
msgid "Only deactivating temporarily"
msgstr "أعطّلها مؤقتًا فقط"

#: pro/licensorpro-client/licensorpro-client.php:1285
msgid "I could not work out how to use it"
msgstr "لم أعرف كيف أستخدمها"

#: pro/licensorpro-client/licensorpro-client.php:1286
msgid "It is missing a feature I need"
msgstr "تنقصها ميزة أحتاجها"

#: pro/licensorpro-client/licensorpro-client.php:1287
msgid "It did not work"
msgstr "لم تعمل"

#: pro/licensorpro-client/licensorpro-client.php:1288
msgid "It broke something on my site"
msgstr "تسببت في عطل في موقعي"

#: pro/licensorpro-client/licensorpro-client.php:1289
msgid "I found a better plugin"
msgstr "وجدت إضافة أفضل"

#: pro/licensorpro-client/licensorpro-client.php:1290
msgid "I no longer need it"
msgstr "لم أعد بحاجة إليها"

#: pro/licensorpro-client/licensorpro-client.php:1291
msgid "Something else"
msgstr "سبب آخر"

#. translators: %s: plugin name.
#: pro/licensorpro-client/licensorpro-client.php:1318
#, php-format
msgid "Before you turn %s off"
msgstr "قبل أن تعطّل %s"

#: pro/licensorpro-client/licensorpro-client.php:1322
msgid "If you have a moment, what went wrong? It is the only way we hear about it."
msgstr "إن كان لديك دقيقة، ما الذي لم يعمل؟ هذه هي الطريقة الوحيدة لنعرف بذلك."

#: pro/licensorpro-client/licensorpro-client.php:1333
msgid "Anything else? (optional)"
msgstr "هل من شيء آخر؟ (اختياري)"

#: pro/licensorpro-client/licensorpro-client.php:1335
msgid "Sends your answer, the plugin version and your site address. Nothing else, and nothing from your site content."
msgstr "يُرسل إجابتك وإصدار الإضافة وعنوان موقعك. لا شيء غير ذلك، ولا شيء من محتوى موقعك."

#: pro/licensorpro-client/licensorpro-client.php:1339
msgid "Send and deactivate"
msgstr "أرسل وعطّل"

#: pro/licensorpro-client/licensorpro-client.php:1342
msgid "Skip and deactivate"
msgstr "تخطَّ وعطّل"

#: pro/licensorpro-client/licensorpro-client.php:1345
#: admin/views/entry-edit.php:138 includes/class-classic-editor.php:90
#: includes/class-classic-editor.php:96 public/class-public-front.php:164
msgid "Cancel"
msgstr "إلغاء"

#: pro/licensorpro-client/licensorpro-client.php:1476
#: pro/licensorpro-client/licensorpro-client.php:1492
msgid "API URL not configured."
msgstr "لم يتم إعداد عنوان API URL."

#: pro/licensorpro-client/licensorpro-client.php:1511
msgid "Unexpected response from license server."
msgstr "رد غير متوقع من خادم التراخيص."

#. translators: %s: human-readable time difference, e.g. "3 months".
#: pro/licensorpro-client/licensorpro-client.php:1898
#: includes/class-dates.php:47
#, php-format
msgid "in %s"
msgstr "خلال %s"

#. translators: %s: human-readable time difference, e.g. "13 days".
#: pro/licensorpro-client/licensorpro-client.php:1899
#: includes/class-dates.php:49
#, php-format
msgid "%s ago"
msgstr "قبل %s"

#: pro/licensorpro-client/licensorpro-client.php:1915
#, php-format
msgid "%s License"
msgstr "ترخيص %s"

#: pro/licensorpro-client/licensorpro-client.php:1925
msgid "This site was deactivated, so its seat is free for another site. Enter the key again here to switch the Pro tools back on."
msgstr "تم تعطيل هذا الموقع، لذا أصبح مقعده متاحًا لموقع آخر. أدخل المفتاح مجددًا هنا لإعادة تشغيل أدوات Pro."

#: pro/licensorpro-client/licensorpro-client.php:1943
#: pro/licensorpro-client/licensorpro-client.php:2491
msgid "Enter your license key first."
msgstr "أدخل مفتاح الترخيص أولًا."

#: pro/licensorpro-client/licensorpro-client.php:1944
msgid "Installing Pro. This takes a few seconds, keep this page open…"
msgstr "جارٍ تثبيت Pro. يستغرق ذلك بضع ثوانٍ، أبقِ هذه الصفحة مفتوحة…"

#: pro/licensorpro-client/licensorpro-client.php:1945
msgid "Reloading to switch on the Pro tools…"
msgstr "جارٍ إعادة التحميل لتشغيل أدوات Pro…"

#: pro/licensorpro-client/licensorpro-client.php:1946
msgid "Reload now"
msgstr "أعد التحميل الآن"

#: pro/licensorpro-client/licensorpro-client.php:1947
msgid "Could not reach the licensing server. Check your connection and try again."
msgstr "تعذّر الوصول إلى خادم التراخيص. تحقق من اتصالك وحاول مجددًا."

#: pro/licensorpro-client/licensorpro-client.php:1948
msgid "Deactivate this license on this site? Premium features switch off here and the seat is freed for another site."
msgstr "هل تريد تعطيل هذا الترخيص على هذا الموقع؟ ستتوقف الميزات المميزة هنا ويصبح المكان متاحًا لموقع آخر."

#: pro/licensorpro-client/licensorpro-client.php:1949
msgid "Done."
msgstr "تم."

#: pro/licensorpro-client/licensorpro-client.php:1950
msgid "Deactivated."
msgstr "تم التعطيل."

#: pro/licensorpro-client/licensorpro-client.php:1951
msgid "Checked."
msgstr "تم الفحص."

#: pro/licensorpro-client/licensorpro-client.php:2122
#: pro/licensorpro-client/licensorpro-client.php:2153
#: pro/licensorpro-client/licensorpro-client.php:2228
msgid "License key"
msgstr "مفتاح الترخيص"

#: pro/licensorpro-client/licensorpro-client.php:2123
#: admin/views/feedback.php:50
msgid "Type"
msgstr "النوع"

#: pro/licensorpro-client/licensorpro-client.php:2125
msgid "Free license: updates of the free version only. It does not switch on Pro."
msgstr "ترخيص Free: تحديثات النسخة المجانية فقط. لا يشغّل Pro."

#: pro/licensorpro-client/licensorpro-client.php:2126
msgid "Free license: updates arrive in your dashboard like any other plugin."
msgstr "ترخيص Free: تصل التحديثات إلى لوحة التحكم مثل أي إضافة أخرى."

#: pro/licensorpro-client/licensorpro-client.php:2128
#: pro/licensorpro-client/licensorpro-client.php:2196
msgid "Last checked"
msgstr "آخر فحص"

#: pro/licensorpro-client/licensorpro-client.php:2132
#: pro/licensorpro-client/licensorpro-client.php:2202
msgid "Check for updates now"
msgstr "تحقق من التحديثات الآن"

#: pro/licensorpro-client/licensorpro-client.php:2135
msgid "Bought Pro?"
msgstr "اشتريت Pro؟"

#: pro/licensorpro-client/licensorpro-client.php:2136
msgid "Enter your Pro license key and Pro is installed over this version. Everything you set up stays."
msgstr "أدخل مفتاح ترخيص Pro وسيُثبَّت Pro فوق هذا الإصدار. كل ما أعددته يبقى كما هو."

#: pro/licensorpro-client/licensorpro-client.php:2138
msgid "Pro license key"
msgstr "مفتاح ترخيص Pro"

#: pro/licensorpro-client/licensorpro-client.php:2141
#: pro/licensorpro-client/licensorpro-client.php:2209
msgid "Install Pro now"
msgstr "ثبّت Pro الآن"

#: pro/licensorpro-client/licensorpro-client.php:2143
msgid "Rather do it by hand? Download the Pro zip from your account and upload it over this plugin."
msgstr "تفضّل القيام بذلك يدويًا؟ نزّل ملف Pro المضغوط (zip) من حسابك وارفعه فوق هذه الإضافة."

#: pro/licensorpro-client/licensorpro-client.php:2144
#: pro/licensorpro-client/licensorpro-client.php:2236
msgid "Go to your account"
msgstr "اذهب إلى حسابك"

#: pro/licensorpro-client/licensorpro-client.php:2157
msgid "this site is not activated"
msgstr "هذا الموقع غير مُفعّل"

#: pro/licensorpro-client/licensorpro-client.php:2158
msgid "this key is for a different plugin"
msgstr "هذا المفتاح لإضافة أخرى"

#: pro/licensorpro-client/licensorpro-client.php:2159
msgid "key not recognised"
msgstr "مفتاح غير معروف"

#: pro/licensorpro-client/licensorpro-client.php:2160
#: pro/licensorpro-client/licensorpro-client.php:2161
msgid "revoked"
msgstr "مُلغى"

#: pro/licensorpro-client/licensorpro-client.php:2165
msgid "active"
msgstr "نشط"

#. translators: %s: date the Pro tools lock
#: pro/licensorpro-client/licensorpro-client.php:2167
#, php-format
msgid "expired, Pro tools stay on until %s"
msgstr "منتهٍ، تبقى أدوات Pro تعمل حتى %s"

#: pro/licensorpro-client/licensorpro-client.php:2168
msgid "expired, Pro tools locked"
msgstr "منتهٍ، أدوات Pro مقفلة"

#: pro/licensorpro-client/licensorpro-client.php:2169
msgid "no longer active (refunded or cancelled)"
msgstr "لم يعد نشطًا (تم الاسترداد أو الإلغاء)"

#. translators: %s: date the Pro tools lock
#: pro/licensorpro-client/licensorpro-client.php:2173
#, php-format
msgid "renewal payment failed, Pro tools stay on until %s"
msgstr "فشل دفع التجديد، تبقى أدوات Pro مفعّلة حتى %s"

#: pro/licensorpro-client/licensorpro-client.php:2175
#: admin/views/entries-list.php:356 admin/views/entry-detail.php:370
#: includes/class-entries.php:686 includes/class-my-submissions.php:52
msgid "Status"
msgstr "الحالة"

#: pro/licensorpro-client/licensorpro-client.php:2177
msgid "Renew"
msgstr "تجديد"

#: pro/licensorpro-client/licensorpro-client.php:2181
msgid "Offline mode"
msgstr "وضع عدم الاتصال"

#: pro/licensorpro-client/licensorpro-client.php:2183
#, php-format
msgid "cached license valid until %s"
msgstr "الترخيص المخزّن مؤقتًا صالح حتى %s"

#: pro/licensorpro-client/licensorpro-client.php:2188
msgctxt "update channel"
msgid "stable"
msgstr "مستقر"

#: pro/licensorpro-client/licensorpro-client.php:2189
msgctxt "update channel"
msgid "beta"
msgstr "بيتا"

#: pro/licensorpro-client/licensorpro-client.php:2190
msgctxt "update channel"
msgid "release candidate"
msgstr "إصدار مرشّح"

#: pro/licensorpro-client/licensorpro-client.php:2191
msgctxt "update channel"
msgid "development"
msgstr "تطوير"

#: pro/licensorpro-client/licensorpro-client.php:2193
msgid "Update channel"
msgstr "قناة التحديث"

#: pro/licensorpro-client/licensorpro-client.php:2194
msgid "Site limit"
msgstr "حد المواقع"

#: pro/licensorpro-client/licensorpro-client.php:2194
msgid "Unlimited"
msgstr "غير محدود"

#: pro/licensorpro-client/licensorpro-client.php:2195
msgid "Expires"
msgstr "ينتهي في"

#: pro/licensorpro-client/licensorpro-client.php:2195
msgid "Never"
msgstr "أبدًا"

#: pro/licensorpro-client/licensorpro-client.php:2200
msgid "Deactivate this site"
msgstr "تعطيل هذا الموقع"

#: pro/licensorpro-client/licensorpro-client.php:2207
msgid "This is the free version, running on your Pro license."
msgstr "هذه هي النسخة المجانية، تعمل على ترخيص Pro الخاص بك."

#: pro/licensorpro-client/licensorpro-client.php:2224
msgid "Have a Pro license key? Enter it here to switch on the Pro tools. It replaces the free license on this site."
msgstr "لديك مفتاح ترخيص Pro؟ أدخله هنا لتشغيل أدوات Pro. سيحل محل الترخيص المجاني على هذا الموقع."

#: pro/licensorpro-client/licensorpro-client.php:2225
msgid "Enter your license key to activate this site."
msgstr "أدخل مفتاح الترخيص لتفعيل هذا الموقع."

#: pro/licensorpro-client/licensorpro-client.php:2232
msgid "Activate"
msgstr "تفعيل"

#: pro/licensorpro-client/licensorpro-client.php:2235
msgid "Your key is in your purchase email and in your account."
msgstr "تجد مفتاحك في رسالة الشراء وفي حسابك."

#: pro/licensorpro-client/licensorpro-client.php:2243
msgid "Need a hand?"
msgstr "تحتاج مساعدة؟"

#: pro/licensorpro-client/licensorpro-client.php:2244
msgid "Contact support"
msgstr "تواصل مع الدعم"

#: pro/licensorpro-client/licensorpro-client.php:2291
msgid "Only someone who may install plugins on this site can install Pro."
msgstr "فقط من يملك صلاحية تثبيت الإضافات على هذا الموقع يمكنه تثبيت Pro."

#: pro/licensorpro-client/licensorpro-client.php:2304
msgid "That is a free license key, so it keeps this free version updated. Pro needs the key from your purchase email."
msgstr "هذا مفتاح ترخيص مجاني، لذا يبقي هذه النسخة المجانية محدّثة. يحتاج Pro إلى المفتاح الموجود في رسالة الشراء."

#. translators: %s: URL of the customer account
#: pro/licensorpro-client/licensorpro-client.php:2309
#, php-format
msgid "Your key is active. Download the Pro zip from your account (%s) and upload it over this plugin instead."
msgstr "مفتاحك نشط. نزّل ملف Pro المضغوط من حسابك (%s) وارفعه فوق هذه الإضافة بدلًا من ذلك."

#: pro/licensorpro-client/licensorpro-client.php:2313
msgid "This site does not allow installing plugins from the dashboard."
msgstr "هذا الموقع لا يسمح بتثبيت الإضافات من لوحة التحكم."

#: pro/licensorpro-client/licensorpro-client.php:2317
msgid "The Pro download could not be fetched for this key."
msgstr "تعذّر جلب تنزيل Pro لهذا المفتاح."

#: pro/licensorpro-client/licensorpro-client.php:2325
msgid "This site asks for FTP details to install plugins."
msgstr "يطلب هذا الموقع بيانات FTP لتثبيت الإضافات."

#: pro/licensorpro-client/licensorpro-client.php:2360
msgid "Installing Pro did not finish."
msgstr "لم يكتمل تثبيت Pro."

#. translators: %s: plugin name
#: pro/licensorpro-client/licensorpro-client.php:2365
#, php-format
msgid "%s Pro is installed and your license is active. Reloading…"
msgstr "تم تثبيت %s Pro وترخيصك نشط. جارٍ إعادة التحميل…"

#: pro/licensorpro-client/licensorpro-client.php:2384
msgid "License activated."
msgstr "تم تفعيل الترخيص."

#: pro/licensorpro-client/licensorpro-client.php:2396
msgid "Site deactivated."
msgstr "تم تعطيل الموقع."

#: pro/licensorpro-client/licensorpro-client.php:2418
msgid "License is valid. Update info refreshed."
msgstr "الترخيص صالح. تم تحديث معلومات التحديث."

#: pro/licensorpro-client/licensorpro-client.php:2452
msgid "Every seat on this license is in use. Deactivate one of your other sites from your account, then try again."
msgstr "كل المواقع المسموح بها في هذا الترخيص مستخدمة. عطّل أحد مواقعك الأخرى من حسابك ثم حاول مجددًا."

#: pro/licensorpro-client/licensorpro-client.php:2455
msgid "This license has expired. Renewing it from your account reactivates this site immediately. Your settings and data are untouched."
msgstr "انتهت صلاحية هذا الترخيص. تجديده من حسابك يعيد تفعيل هذا الموقع فورًا، وتبقى إعداداتك وبياناتك كما هي."

#: pro/licensorpro-client/licensorpro-client.php:2457
msgid "The last renewal payment for this license did not go through, so it is paused. Update your payment details in your account and it switches back on. Your settings and data are untouched."
msgstr "لم تكتمل آخر دفعة تجديد لهذا الترخيص، لذا تم إيقافه مؤقتًا. حدّث بيانات الدفع في حسابك وسيعود للعمل. إعداداتك وبياناتك لم تُمس."

#: pro/licensorpro-client/licensorpro-client.php:2460
msgid "This license was cancelled or refunded, so it no longer switches on Pro. If that is a mistake, reply to your purchase email."
msgstr "تم إلغاء هذا الترخيص أو استرداد ثمنه، لذا لم يعد يفعّل Pro. إن كان ذلك خطأ، فرُدّ على رسالة الشراء."

#: pro/licensorpro-client/licensorpro-client.php:2463
msgid "That key was not recognised. Check for a missing character, or copy it again from your purchase email."
msgstr "لم نتعرّف على هذا المفتاح. تأكد من عدم نقص أي حرف، أو انسخه مجددًا من رسالة الشراء."

#: pro/licensorpro-client/licensorpro-client.php:2465
msgid "This key is for a different plugin. Each plugin has its own key: use the one from the purchase email for this plugin."
msgstr "هذا المفتاح لإضافة أخرى. لكل إضافة مفتاحها الخاص: استخدم المفتاح الموجود في رسالة شراء هذه الإضافة."

#: pro/licensorpro-client/licensorpro-client.php:2468
msgid "This key has been revoked. If you believe that is a mistake, reply to your purchase email and we will sort it out."
msgstr "تم إلغاء هذا المفتاح. إن كنت ترى أن ذلك خطأ، فردّ على رسالة الشراء وسنحلّ الأمر."

#: pro/licensorpro-client/licensorpro-client.php:2470
msgid "This site is not activated on this license any more. Enter the key again to activate it."
msgstr "لم يعد هذا الموقع مفعّلًا على هذا الترخيص. أدخل المفتاح مرة أخرى لتفعيله."

#: pro/licensorpro-client/licensorpro-client.php:2472
msgid "That is a free license key. It keeps the free version updated but does not switch on Pro. Enter the Pro key from your purchase email."
msgstr "هذا مفتاح ترخيص مجاني. يُبقي النسخة المجانية محدّثة لكنه لا يفعّل Pro. أدخل مفتاح Pro من رسالة الشراء."

#: pro/licensorpro-client/licensorpro-client.php:2475
msgid "This plugin has no free license. Use the key from your purchase email."
msgstr "لا يوجد ترخيص مجاني لهذه الإضافة. استخدم المفتاح من رسالة الشراء."

#: pro/licensorpro-client/licensorpro-client.php:2477
msgid "The licensing server does not know this plugin. Update the plugin, or reply to your purchase email."
msgstr "خادم التراخيص لا يعرف هذه الإضافة. حدّث الإضافة أو رُدّ على رسالة الشراء."

#: pro/licensorpro-client/licensorpro-client.php:2479
msgid "This site's license session ran out. Check the license again to renew it."
msgstr "انتهت جلسة الترخيص لهذا الموقع. تحقّق من الترخيص مرة أخرى لتجديدها."

#: pro/licensorpro-client/licensorpro-client.php:2482
msgid "The download link has expired. Check for updates again to get a fresh one."
msgstr "انتهت صلاحية رابط التنزيل. ابحث عن التحديثات مرة أخرى للحصول على رابط جديد."

#: pro/licensorpro-client/licensorpro-client.php:2484
msgid "The download is not on the server right now. Try again later, or download the zip from your account."
msgstr "التنزيل غير متوفر على الخادم حاليًا. حاول لاحقًا أو نزّل ملف zip من حسابك."

#: pro/licensorpro-client/licensorpro-client.php:2486
msgid "Enter a valid email address."
msgstr "أدخل عنوان بريد إلكتروني صالحًا."

#: pro/licensorpro-client/licensorpro-client.php:2489
msgid "The request to the licensing server was missing details. Reload this page and try again."
msgstr "كان الطلب المرسل إلى خادم التراخيص ينقصه بعض التفاصيل. أعد تحميل هذه الصفحة وحاول مجددًا."

#: pro/licensorpro-client/licensorpro-client.php:2493
msgid "The answer from the licensing server could not be verified, so it was not trusted. Try again in a few minutes. If it keeps happening, reply to your purchase email."
msgstr "تعذّر التحقق من رد خادم التراخيص، لذا لم يُعتمد. حاول مجددًا بعد بضع دقائق. إن تكرر ذلك، فرُدّ على رسالة الشراء."

#: pro/licensorpro-client/licensorpro-client.php:2496
msgid "Could not reach the licensing server. Your site may be blocking outbound requests. This is usually temporary, so try again in a minute."
msgstr "تعذّر الوصول إلى خادم التراخيص. ربما يمنع موقعك الطلبات الخارجية. غالبًا يكون ذلك مؤقتًا، فحاول مجددًا بعد دقيقة."

#: pro/licensorpro-client/licensorpro-client.php:2499
msgid "Too many attempts in a short window. Wait a minute and try again."
msgstr "محاولات كثيرة خلال وقت قصير. انتظر دقيقة ثم حاول مجددًا."

#: pro/licensorpro-client/licensorpro-client.php:2501
msgid "The licensing server had a problem on its side. Your key was not rejected. Try again in a few minutes, and if it keeps happening, reply to your purchase email."
msgstr "حدثت مشكلة في خادم التراخيص من جهته، ولم يُرفض مفتاحك. حاول مجددًا بعد بضع دقائق، وإن تكرر ذلك فردّ على رسالة الشراء."

#. translators: %s: short error code from the licensing server
#: pro/licensorpro-client/licensorpro-client.php:2505
#, php-format
msgid "The licensing server could not confirm this license (%s). Try again in a few minutes. If it keeps happening, reply to your purchase email and quote that code."
msgstr "تعذّر على خادم التراخيص تأكيد هذا الترخيص (%s). حاول مجددًا بعد بضع دقائق. إن تكرر ذلك، فرُدّ على رسالة الشراء واذكر هذا الرمز."

#: pro/licensorpro-client/licensorpro-client.php:2531
msgid "Permission denied."
msgstr "تم رفض الإذن."

